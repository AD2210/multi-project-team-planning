<div {{ attributes }} class="mptp mptp-user-view container-fluid">
    {% include '@MultiProjectTeamPlanning/components/user/_toolbar.html.twig' with {
        ui: this.ui,
        comp: this
    } only %}

    {% include '@MultiProjectTeamPlanning/components/user/_grid_header.html.twig' with {
        days: this.daysForView
    } only %}

    <div class="mptp-grid-scroll">
        {% include '@MultiProjectTeamPlanning/components/user/_grid_body.html.twig' with {
        ui: this.ui,
        comp: this,
        days: this.daysForView,
        grid: this.grid,
        csrf: this.csrfTokenValue
        } only %}
    </div>
</div>