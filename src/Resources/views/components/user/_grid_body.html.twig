{% set g = ui.grid %}
{% set rows = grid.rows %}
{% set api = ui.api %}

<div class="mptp-grid mptp-grid-body"
     tabindex="0"
     data-controller="planner-grid"
     data-action="
       pointerdown->planner-grid#pointerDown
       click->planner-grid#selectSlot
       planner-grid:update-context->planner-grid#updateContext
       keydown->planner-grid#keyDown
       keydown@window->planner-grid#keyDown"
     data-planner-grid-minute-step-value="{{ g.minute_step }}"
     data-planner-grid-row-height-value="28"
     data-planner-grid-first-minute-value="{{ rows|first.minute }}"
     data-planner-grid-list-url-value="{{ api.list_url ?? '' }}"
     data-planner-grid-create-url-value="{{ api.create_url ?? '' }}"
     data-planner-grid-update-url-template-value="{{ api.update_url_template ?? '' }}"
     data-planner-grid-duplicate-url-template-value="{{ api.duplicate_url_template ?? '' }}"
     data-planner-grid-delete-url-template-value="{{ api.delete_url_template ?? '' }}"
     data-planner-grid-csrf-header-value="{{ api.csrf_header ?? 'X-CSRF-TOKEN' }}"
     data-planner-grid-csrf-token-value="{{ csrf }}"
     data-planner-grid-mode-value="{{ comp.mode }}"
     data-planner-grid-user-id-value="{{ comp.userId ?? '' }}"
     data-planner-grid-project-id-value="{{ comp.projectId ?? '' }}"
     data-planner-grid-timezone-value="{{ ui.tz }}"
     data-planner-grid-range-start-value="{{ rangeStart }}"
     data-planner-grid-range-end-value="{{ rangeEnd }}"
     style="grid-template-columns: 90px repeat({{ days|length }}, 1fr);">

    <div class="mptp-hours">
        {% for r in rows %}
            {% set isHour = (r.minute % 60 == 0) %}
            <div class="cell {{ isHour ? 'is-hour' : '' }}">
                {% if isHour %}{{ r.label }}{% endif %}
            </div>
        {% endfor %}
    </div>

    {% for d in days %}
        <div class="mptp-col {{ d.ymd == 'now'|date('Y-m-d') and g.highlight_current_day ? 'today' }}"
             data-planner-grid-target="dayCol"
             data-date="{{ d.ymd }}">
        {% if g.now_indicator and d.date|date('Y-m-d') == 'now'|date('Y-m-d') %}
                {% set nowMinute = 'now'|date('H')*60 + 'now'|date('i') %}
                {% set firstRow = rows|first %}
                {% set offset = max([(nowMinute - firstRow.minute) / (g.minute_step), 0]) %}
                <div class="mptp-now" style="top: calc({{ offset }} * var(--mptp-row-h));"></div>
            {% endif %}

            {% for r in rows %}
                <div class="slot-row {{ (r.minute % 60 == 0) ? 'is-hour' : 'is-half' }}"
                     data-minute="{{ r.minute }}"></div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
