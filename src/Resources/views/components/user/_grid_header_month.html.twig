{% set weekDaysCount = ui.toolbar.views.month.show_weekends ? 7 : 5 %}
<div class="mptp-grid mptp-grid-header mptp-grid-month"
     style="grid-template-columns: 40px repeat({{ weekDaysCount }}, 1fr);">
    <div class="week-label border-bottom">&nbsp;</div>
    {% for day in days|slice(0, weekDaysCount) %}
        <div class="text-center fw-bold border-bottom">{{ day.dayOfWeekLabel|title }}</div>
    {% endfor %}
</div>
