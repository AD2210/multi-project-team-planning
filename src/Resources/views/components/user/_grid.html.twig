{% set g = ui.grid %}
{% set rows = grid.rows %}
{% set days = window.days %}
{% set showNow = g.now_indicator %}
{% set highlightDay = g.highlight_current_day %}

<style>
    .mptp-grid { display:grid; grid-template-columns: 80px repeat({{ days|length }}, 1fr); }
    .mptp-hours { border-right:1px solid #e5e7eb; }
    .mptp-hours .cell { height: 28px; display:flex; align-items:flex-start; padding-top:2px; font-size:.78rem; color:#6b7280; }
    .mptp-col { border-left:1px solid #e5e7eb; position:relative; }
    .mptp-col .slot-row { height: 28px; border-top: 1px solid rgba(0,0,0,{{ g.half_hour_opacity }}); }
    .mptp-col .slot-row:nth-child(2n+1){ border-top-color:#e5e7eb; }
    .mptp-col.today { background: linear-gradient(0deg, rgba(255,235,59,.07), rgba(255,235,59,.07)); }
    .mptp-now { position:absolute; left:0; right:0; height:2px; background:#ef4444; z-index:2; }
    .mptp-day-header { padding:6px 8px; font-weight:600; border-bottom:1px solid #e5e7eb; }
</style>

<div class="mptp-grid">
    <div class="mptp-hours">
        <div class="mptp-day-header">&nbsp;</div>
        {% for r in rows %}
            <div class="cell">{{ r.label }}</div>
        {% endfor %}
    </div>

    {% for d in days %}
        {% set isToday = (highlightDay and d|date('Y-m-d') == 'now'|date('Y-m-d')) %}
        <div class="mptp-col {{ isToday ? 'today' }}">
            <div class="mptp-day-header">{{ d|date(g.day_label_format) }}</div>

            {% if showNow and isToday %}
                {% set nowMinute = 'now'|date('H')*60 + 'now'|date('i') %}
                {% set firstRow = rows|first %}
                {% set firstMinute = firstRow.minute %}
                {% set offsetMin = max([nowMinute - firstMinute, 0]) %}
                <div class="mptp-now" style="top: {{ (offsetMin / (g.minute_step)) * 28 + 28 }}px"></div>
            {% endif %}

            {% for r in rows %}
                <div class="slot-row"></div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
